{
  "name": "seaps-reports",
  "version": "1.0.0",
  "private": true,
  "description": "Gera os PDFs do SEAPS (React + Tailwind v3 -> HTML -> WeasyPrint)",
  "license": "ISC",
  "scripts": {
    "dev": "npm run build:css && (tailwindcss -i src/styles/paged.css -o dist/styles.css --watch=always & tsx watch src/server.ts)",
    "build:css": "tailwindcss -i src/styles/paged.css -o dist/styles.css --minify",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && npm run build:css",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "morgan": "^1.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "winston": "^3.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.4",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "~3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
